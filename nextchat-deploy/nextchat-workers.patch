@@ -0,0 +1,34 @@
+{
+  "$schema": "node_modules/wrangler/config-schema.json",
+  "name": "nextchat-aiweb",
+  "main": ".open-next/worker.js",
+  "compatibility_date": "2026-11-17",
+  "compatibility_flags": [
+    "nodejs_compat",
+    "global_fetch_strictly_public"
+  ],
+  "assets": {
+    "directory": ".open-next/assets",
+    "binding": "ASSETS"
+  },
+  "services": [
+    {
+      "binding": "WORKER_SELF_REFERENCE",
+      "service": "nextchat-aiweb"
+    }
+  ],
+  "routes": [
+    {
+      "pattern": "aiweb.cheapapi.com.cn",
+      "custom_domain": true
+    }
+  ],
+  "workers_dev": true,
+  "vars": {
+    "NEXTJS_ENV": "production",
+    "DISABLE_FAST_LINK": "true"
+  },
+  "observability": {
+    "enabled": false
+  }
+}
